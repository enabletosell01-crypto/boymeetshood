# ─────────────────────────────────────────────────────────────
# HoodMeetsBoy — environment
# Copy these into Vercel → Project → Settings → Environment Variables
# (Production, Preview and Development).
# ─────────────────────────────────────────────────────────────

# 1. BLOB STORE — DO NOT ADD THIS BY HAND.
#    Vercel → Storage → Create Database → Blob → Connect to this project.
#    Connecting injects BLOB_READ_WRITE_TOKEN automatically.
#    (Only paste it manually when running locally.)
# BLOB_READ_WRITE_TOKEN=vercel_blob_rw_xxxxxxxxxxxxxxxx

# 2. Keys the waitlist blob names off. Changing it orphans existing
#    entries (they stay in the store but stop de-duplicating), so set it
#    once and leave it alone.
WAITLIST_SALT=replace-with-a-64-char-random-hex-string

# 3. Password for GET /api/waitlist/export — this is what lets you
#    download the waitlist. Keep it private.
WAITLIST_ADMIN_TOKEN=replace-with-a-long-random-string

# 4. Canonical URL, used for OG tags, sitemap and canonical links.
NEXT_PUBLIC_SITE_URL=https://hoodmeetsboy.xyz
