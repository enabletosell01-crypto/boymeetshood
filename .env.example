# ─────────────────────────────────────────────────────────────
# BoyMeetsHood — environment
# Copy to .env.local for development; add the same keys in
# Vercel → Project → Settings → Environment Variables.
# ─────────────────────────────────────────────────────────────

# 1. Neon Postgres. The pooled URL is what the app queries at runtime.
#    Vercel → Storage → Neon → Connect to Project sets this for you,
#    along with a pile of PG*/POSTGRES_* aliases the app ignores.
DATABASE_URL=postgresql://user:password@ep-xxxx-pooler.region.aws.neon.tech/neondb?sslmode=require

# 2. Direct (non-pooled) URL. Only `npm run db:setup` uses it — pgbouncer
#    is meant for query traffic, not schema changes. Optional: the setup
#    falls back to DATABASE_URL.
DATABASE_URL_UNPOOLED=postgresql://user:password@ep-xxxx.region.aws.neon.tech/neondb?sslmode=require

# 3. Password for GET /api/waitlist/export — this is what lets you
#    download the waitlist. Keep it private.
WAITLIST_ADMIN_TOKEN=replace-with-a-long-random-string

# 4. Canonical URL, used for OG tags, sitemap and canonical links.
NEXT_PUBLIC_SITE_URL=https://boymeetshood.xyz

# 5. Genesis mint date, ISO 8601. LEAVE THIS UNSET until the date is real:
#    the hero then reads "TO BE ANNOUNCED · STAY TUNED". Set it and the
#    live countdown takes over, ticking down to that exact instant.
#    Redeploy after changing it — it is baked in at build time.
# NEXT_PUBLIC_MINT_AT=2026-10-01T15:00:00Z

# 6. Set to `off` to skip the lime splash and the breach-in glitch, so the
#    page loads straight into the content. Any other value (or unset) keeps
#    the intro. Baked in at build time — redeploy after changing.
# NEXT_PUBLIC_INTRO=off
